# Copy to .env and paste your key. .env is git-ignored and must never be committed.
#   cp .env.example .env && open -e .env
#
# This file is the COMMITTED placeholder — leave the value empty.
DEEPSEEK_API_KEY=

# deepseek-chat supports tool calling; deepseek-reasoner does not.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set to 1 to force the deterministic agent even when a key is present.
INSIGHT_COPILOT_MOCK=0
